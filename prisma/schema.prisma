// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Teacher {
  id     Int    @id @default(autoincrement())
  name   String
  email  String @unique
  password String // stored as a bcrypt hash

  // Basic contact info
  phone    String?
  photoUrl String?

  // Personal details
  dateOfBirth DateTime?
  nationality String?

  // Employment details
  subject                  String?
  qualification            String?
  rank                     String?
  firstAppointmentDate     DateTime?
  dateAppointedCurrentRank DateTime?

  // National ID numbers
  ghanaCardNumber String? @unique
  ssnitNumber     String? @unique

  createdAt DateTime @default(now())

  attendance    Attendance[]
  lessonNotes   LessonNote[]
  acknowledgements AnnouncementAck[]
  notifications Notification[]
}

model Attendance {
  id        Int       @id @default(autoincrement())
  teacherId Int
  teacher   Teacher   @relation(fields: [teacherId], references: [id])
  date      DateTime  @default(now())
  status    String    // "present", "late", or "absent"
  checkIn   DateTime?
  createdAt DateTime  @default(now())
}

model LessonNote {
  id         Int       @id @default(autoincrement())
  teacherId  Int
  teacher    Teacher   @relation(fields: [teacherId], references: [id])
  title      String
  subject    String?
  week       String?
  fileName   String
  filePath   String
  status     String    @default("pending") // "pending", "approved", "needs_revision"
  comment    String?
  summary    String?   // AI-generated one-line summary of the note's content
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
}

// A headteacher post — either a plain announcement (no eventDate) or a
// calendar event (has an eventDate/time). Teachers acknowledge it, and the
// headteacher is notified back when they do.
model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  eventDate DateTime? // set = shows on the calendar as an event; null = plain announcement
  createdAt DateTime  @default(now())

  acknowledgements AnnouncementAck[]
}

model AnnouncementAck {
  id             Int          @id @default(autoincrement())
  announcementId Int
  announcement   Announcement @relation(fields: [announcementId], references: [id])
  teacherId      Int
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  acknowledgedAt DateTime     @default(now())

  @@unique([announcementId, teacherId])
}

// A single notification bell entry. For headteacher notifications,
// teacherId is left empty since there's only one headteacher account.
model Notification {
  id            Int      @id @default(autoincrement())
  recipientRole String   // "headteacher" or "teacher"
  teacherId     Int?
  teacher       Teacher? @relation(fields: [teacherId], references: [id])
  type          String   // "note_reviewed", "new_announcement", "announcement_ack"
  message       String
  relatedId     Int?     // e.g. the lessonNoteId or announcementId this refers to
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())
}
